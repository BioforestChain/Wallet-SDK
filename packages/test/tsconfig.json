        "src/common/common.test.ts",
        "src/constant.ts",
        "src/helper/base.helper.ts",
        "src/helper/index.ts",
        "src/index.ts",
        "src/test-main.ts",
        "src/test.app.ts",
        "src/test.module.ts",
        "src/trans/trans-api.test.ts",
        "src/trans/trans-test.module.ts"
